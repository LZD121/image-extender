# Midscene model config for the AI-driven E2E suite (npm run test:ai).
#
# Copy to `.env.midscene` (gitignored) and fill in your endpoint. This repo's
# default setup points at a LOCAL OpenAI-compatible gateway, which is why the
# real file normally holds no secret at all.
#
# Requirements, in Midscene's terms: a multimodal model with UI localization
# (it must return element coordinates from a screenshot), plus the matching
# MIDSCENE_MODEL_FAMILY adapter name.
#
# Verified working on 2026-10-05 against a local magpie gateway
# (http://127.0.0.1:3425/v1, auth: none) with:
#   MIDSCENE_MODEL_NAME=commandcode/Qwen/Qwen3.7-Plus
#   MIDSCENE_MODEL_FAMILY=qwen3
# `npx @midscene/cli model verify` passes both its text and AI-locate checks.
#
# Check any config with:  npx @midscene/cli model verify

MIDSCENE_MODEL_BASE_URL=http://127.0.0.1:3425/v1
MIDSCENE_MODEL_API_KEY=none
MIDSCENE_MODEL_NAME=commandcode/Qwen/Qwen3.7-Plus
MIDSCENE_MODEL_FAMILY=qwen3
