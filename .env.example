# Optional: only needed if you want a server-side fallback key for local dev
# or for self-hosted demos. The app is BYOK (bring your own key) by default —
# the OpenRouter key is collected from the user in-browser on first run and
# stored in their browser's localStorage, never on the server.
#
# Get a key at: https://openrouter.ai/keys

OPENROUTER_API_KEY=

# Which gateway the app talks to is a *browser* setting (Settings → Gateway:
# OpenRouter or Magpie). These two are the server-side facts about Magpie.
#
# Base URL of an OpenAI-compatible gateway. Default: http://127.0.0.1:3425/v1
# (a local magpie gateway). Point it at a tunnel or a hosted instance when the
# gateway is not on this machine.
IE_MAGPIE_BASE_URL=

# Optional key for that gateway. The local default needs none; a tunnelled or
# hosted gateway may. A key entered in Settings overrides this.
MAGPIE_API_KEY=

# Where the local asset library lives (default: <repo>/assets).
IE_ASSETS_DIR=

# Force the label recorded in each asset's meta.json provenance.backend.
# Leave empty to accept the client's value when it is one of openrouter | pixellab,
# otherwise 'openrouter' is recorded.
IE_BACKEND_LABEL=
